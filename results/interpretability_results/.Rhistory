file1 <- "experiments/ai_argicoluture/sum_up.ods"
file2 <- "experiments/beans/sum_up.ods"
file3 <- "experiments/gaming_behaviour/sum_up.ods"
file4 <- "experiments/iris/sum_up.ods"
file5 <- "experiments/pollution/sum_up.ods"
read_test <- function(file){
df <- read_ods(file)
names(df) <- c(
"run",
"length_no_bg",
"length_bg",
"split",
"rule_ratio",
"acc_no_bg",
"acc_bg"
)
# Remove the MEANS row
df <- df[df$run != "MEANS:", ]
df$length_no_bg <- as.numeric(df$length_no_bg)
df$length_bg    <- as.numeric(df$length_bg)
df$split        <- as.numeric(df$split)
df$acc_no_bg    <- as.numeric(df$acc_no_bg)
df$acc_bg       <- as.numeric(df$acc_bg)
df
}
data <- bind_rows(
read_test(file1),
read_test(file2),
read_test(file3),
read_test(file4),
read_test(file5)
)
length_summary <-
data %>%
group_by(split) %>%
summarise(
mean_no_bg = mean(length_no_bg),
sd_no_bg   = sd(length_no_bg),
mean_bg    = mean(length_bg),
sd_bg      = sd(length_bg),
.groups="drop"
) %>%
pivot_longer(
cols=-split,
names_to=c(".value","group"),
names_pattern="(mean|sd)_(.*)"
)
length_summary$group <- factor(
length_summary$group,
levels=c("no_bg","bg"),
labels=c("Without BG","With BG")
)
accuracy_summary <-
data %>%
group_by(split) %>%
summarise(
mean_no_bg = mean(acc_no_bg),
sd_no_bg   = sd(acc_no_bg),
mean_bg    = mean(acc_bg),
sd_bg      = sd(acc_bg),
.groups="drop"
) %>%
pivot_longer(
cols=-split,
names_to=c(".value","group"),
names_pattern="(mean|sd)_(.*)"
)
accuracy_summary$group <- factor(
accuracy_summary$group,
levels=c("no_bg","bg"),
labels=c("Without BG","With BG")
)
p1 <- ggplot(length_summary,
aes(x=factor(split),
y=mean,
color=group,
group=group)) +
geom_line(linewidth=1) +
geom_point(size=3) +
geom_errorbar(aes(ymin=mean-sd,
ymax=mean+sd),
width=.05) +
theme_bw(base_size=14) +
labs(title="Hypothesis Length",
x="Training Split",
y="Average Length",
color=NULL)
p2 <- ggplot(accuracy_summary,
aes(x=factor(split),
y=mean,
color=group,
group=group)) +
geom_line(linewidth=1) +
geom_point(size=3) +
geom_errorbar(aes(ymin=mean-sd,
ymax=mean+sd),
width=.05) +
ylim(0,1) +
theme_bw(base_size=14) +
labs(title="Accuracy",
x="Training Split",
y="Average Accuracy",
color=NULL)
final_plot <- p1 / p2 +
plot_layout(guides = "collect")
print(final_plot)
ggsave(
"background_knowledge_summary.pdf",
final_plot,
width = 8,
height = 9
)
library(readODS)
library(dplyr)
library(tidyr)
library(ggplot2)
library(patchwork)
file1 <- "experiments/ai_argicoluture/sum_up.ods"
file2 <- "experiments/beans/sum_up.ods"
file3 <- "experiments/gaming_behaviour/sum_up.ods"
file4 <- "experiments/iris/sum_up.ods"
file5 <- "experiments/pollution/sum_up.ods"
read_test <- function(file, dataset){
df <- read_ods(file)
names(df) <- c(
"run",
"length_no_bg",
"length_bg",
"split",
"rule_ratio",
"acc_no_bg",
"acc_bg"
)
# Remove MEANS row
df <- df[df$run != "MEANS:", ]
df$length_no_bg <- as.numeric(df$length_no_bg)
df$length_bg    <- as.numeric(df$length_bg)
df$split        <- as.numeric(df$split)
df$acc_no_bg    <- as.numeric(df$acc_no_bg)
df$acc_bg       <- as.numeric(df$acc_bg)
df$dataset <- dataset
df
}
data <- bind_rows(
read_test(file1, "Agriculture"),
read_test(file2, "Beans"),
read_test(file3, "Gaming"),
read_test(file4, "Iris"),
read_test(file5, "Pollution")
)
# Preserve desired order
data$dataset <- factor(
data$dataset,
levels = c("Agriculture","Beans","Gaming","Iris","Pollution")
)
length_summary <-
data %>%
group_by(dataset) %>%
summarise(
mean_no_bg = mean(length_no_bg),
sd_no_bg   = sd(length_no_bg),
mean_bg    = mean(length_bg),
sd_bg      = sd(length_bg),
.groups = "drop"
) %>%
pivot_longer(
cols = -dataset,
names_to = c(".value","group"),
names_pattern = "(mean|sd)_(.*)"
)
length_summary$group <- factor(
length_summary$group,
levels = c("no_bg","bg"),
labels = c("Without BG","With BG")
)
accuracy_summary <-
data %>%
group_by(dataset) %>%
summarise(
mean_no_bg = mean(acc_no_bg),
sd_no_bg   = sd(acc_no_bg),
mean_bg    = mean(acc_bg),
sd_bg      = sd(acc_bg),
.groups = "drop"
) %>%
pivot_longer(
cols = -dataset,
names_to = c(".value","group"),
names_pattern = "(mean|sd)_(.*)"
)
accuracy_summary$group <- factor(
accuracy_summary$group,
levels = c("no_bg","bg"),
labels = c("Without BG","With BG")
)
p1 <- ggplot(length_summary,
aes(x = dataset,
y = mean,
fill = group)) +
geom_col(position = position_dodge(0.75),
width = 0.65) +
geom_errorbar(
aes(ymin = mean - sd,
ymax = mean + sd),
position = position_dodge(0.75),
width = 0.2
) +
theme_bw(base_size = 14) +
labs(
title = "Average Hypothesis Length",
x = "",
y = "Length",
fill = NULL
)
p2 <- ggplot(accuracy_summary,
aes(x = dataset,
y = mean,
fill = group)) +
geom_col(position = position_dodge(0.75),
width = 0.65) +
geom_errorbar(
aes(ymin = mean - sd,
ymax = mean + sd),
position = position_dodge(0.75),
width = 0.2
) +
ylim(0,1) +
theme_bw(base_size = 14) +
labs(
title = "Average Accuracy",
x = "",
y = "Accuracy",
fill = NULL
)
final_plot <-
p1 /
p2 +
plot_layout(guides = "collect")
print(final_plot)
ggsave(
"background_knowledge_summary.pdf",
final_plot,
width = 9,
height = 9
)
library(readODS)
library(dplyr)
library(tidyr)
library(ggplot2)
library(ggbreak)
library(patchwork)
file1 <- "experiments/ai_argicoluture/sum_up.ods"
file2 <- "experiments/beans/sum_up.ods"
file3 <- "experiments/gaming_behaviour/sum_up.ods"
file4 <- "experiments/iris/sum_up.ods"
file5 <- "experiments/pollution/sum_up.ods"
read_test <- function(file,name){
df <- read_ods(file)
names(df) <- c(
"run",
"length_no_bg",
"length_bg",
"split",
"rule_ratio",
"acc_no_bg",
"acc_bg"
)
df <- df[df$run!="MEANS:",]
df$length_no_bg <- as.numeric(df$length_no_bg)
df$length_bg    <- as.numeric(df$length_bg)
df$acc_no_bg    <- as.numeric(df$acc_no_bg)
df$acc_bg       <- as.numeric(df$acc_bg)
df$dataset <- name
df
}
data <- bind_rows(
read_test(file1,"Agriculture"),
read_test(file2,"Beans"),
read_test(file3,"Gaming"),
read_test(file4,"Iris"),
read_test(file5,"Pollution")
)
data$dataset <- factor(data$dataset,
levels=c("Agriculture","Beans","Gaming","Iris","Pollution"))
length_summary <-
data %>%
group_by(dataset) %>%
summarise(
Without_BG=mean(length_no_bg),
With_BG=mean(length_bg),
SD_Without=sd(length_no_bg),
SD_With=sd(length_bg),
.groups="drop"
)
length_plot <-
rbind(
data.frame(dataset=length_summary$dataset,
group="Without BG",
mean=length_summary$Without_BG,
sd=length_summary$SD_Without),
data.frame(dataset=length_summary$dataset,
group="With BG",
mean=length_summary$With_BG,
sd=length_summary$SD_With)
)
accuracy_summary <-
data %>%
group_by(dataset) %>%
summarise(
Without_BG=mean(acc_no_bg),
With_BG=mean(acc_bg),
SD_Without=sd(acc_no_bg),
SD_With=sd(acc_bg),
.groups="drop"
)
accuracy_plot <-
rbind(
data.frame(dataset=accuracy_summary$dataset,
group="Without BG",
mean=accuracy_summary$Without_BG,
sd=accuracy_summary$SD_Without),
data.frame(dataset=accuracy_summary$dataset,
group="With BG",
mean=accuracy_summary$With_BG,
sd=accuracy_summary$SD_With)
)
p1 <- ggplot(length_plot,
aes(dataset,mean,fill=group))+
geom_col(position="dodge",width=.7)+
geom_errorbar(aes(ymin=mean-sd,
ymax=mean+sd),
position=position_dodge(.7),
width=.2)+
scale_y_break(c(70,350))+
theme_bw(base_size=15)+
labs(title="Average Hypothesis Length",
x="",
y="Literals",
fill=NULL)
p2 <- ggplot(accuracy_plot,
aes(dataset,mean,fill=group))+
geom_col(position="dodge",width=.7)+
geom_errorbar(aes(ymin=mean-sd,
ymax=mean+sd),
position=position_dodge(.7),
width=.2)+
coord_cartesian(ylim=c(0,1))+
theme_bw(base_size=15)+
labs(title="Average Accuracy",
x="",
y="Accuracy",
fill=NULL)
final <- p1/p2
print(final)
ggsave("absolute_results.pdf",
final,
width=9,
height=9)
library(readODS)
library(dplyr)
library(ggplot2)
file1 <- "experiments/ai_argicoluture/sum_up.ods"
file2 <- "experiments/beans/sum_up.ods"
file3 <- "experiments/gaming_behaviour/sum_up.ods"
file4 <- "experiments/iris/sum_up.ods"
file5 <- "experiments/pollution/sum_up.ods"
read_test <- function(file,name){
df <- read_ods(file)
names(df) <- c(
"run",
"length_no_bg",
"length_bg",
"split",
"rule_ratio",
"acc_no_bg",
"acc_bg")
df <- df[df$run!="MEANS:",]
df$length_no_bg <- as.numeric(df$length_no_bg)
df$length_bg <- as.numeric(df$length_bg)
df$acc_no_bg <- as.numeric(df$acc_no_bg)
df$acc_bg <- as.numeric(df$acc_bg)
df$dataset <- name
df
}
data <- bind_rows(
read_test(file1,"Agriculture"),
read_test(file2,"Beans"),
read_test(file3,"Gaming"),
read_test(file4,"Iris"),
read_test(file5,"Pollution")
)
data <- data %>%
mutate(
Reduction =
100*(length_no_bg-length_bg)/length_no_bg,
AccuracyGain =
100*(acc_bg-acc_no_bg)
)
summary <-
data %>%
group_by(dataset) %>%
summarise(
Reduction=mean(Reduction),
ReductionSD=sd(Reduction),
AccuracyGain=mean(AccuracyGain),
AccuracySD=sd(AccuracyGain),
.groups="drop"
)
scaleFactor <- max(summary$Reduction)/max(summary$AccuracyGain)
ggplot(summary,
aes(dataset,Reduction))+
geom_col(fill="steelblue",width=.6)+
geom_errorbar(aes(
ymin=Reduction-ReductionSD,
ymax=Reduction+ReductionSD),
width=.2)+
geom_line(aes(
y=AccuracyGain*scaleFactor,
group=1),
linewidth=1.2,
colour="red")+
geom_point(aes(
y=AccuracyGain*scaleFactor),
size=3,
colour="red")+
scale_y_continuous(
name="Hypothesis Reduction (%)",
sec.axis=sec_axis(~./scaleFactor,
name="Accuracy Gain (%)")
)+
theme_bw(base_size=15)+
labs(
title="Effect of Background Knowledge",
x="Dataset"
)
ggsave(
"relative_improvement.pdf",
width=9,
height=5)
